#!/usr/bin/env bash
# audio-switch — rofi audio / Bluetooth output switcher (Omega audio setup, 2026-10-25)
# Click target of the genmon-audio.sh panel widget. Undo: rm ~/.local/bin/audio-switch
set -uo pipefail

JBL=XX:XX:XX:XX:XX:XX
Q1=XX:XX:XX:XX:XX:XX
JBL_SINK=bluez_output.F8_5C_7E_A7_22_75.1
Q1_SINK=bluez_output.33_00_1F_72_86_60.1

notify() { command -v notify-send >/dev/null && notify-send -i audio-card "Audio" "$1" 2>/dev/null; true; }

move_all() {
    local id
    for id in $(pactl list short sink-inputs | cut -f1); do
        pactl move-sink-input "$id" "$1" 2>/dev/null || true
    done
}

set_sink() {
    [[ -n "${1:-}" ]] || { notify "No such output"; return 1; }
    pactl set-default-sink "$1" && move_all "$1" && notify "Output: $1"
}

wait_sink() {
    local _
    for _ in $(seq 20); do
        pactl list short sinks | grep -q "$1" && return 0
        sleep 0.5
    done
    notify "Timed out waiting for $1"
    return 1
}

laptop_sink() { pactl list short sinks | awk '/alsa_output.*analog-stereo/{print $2; exit}'; }

items=(
    "Q1 receiver -> amp (connect + music, A2DP)"
    "JBL Charge 5 (connect + use)"
    "Laptop speakers / headphone jack"
    "Q1 call mode (HFP mic - may feed back)"
    "EQ preset: LoudnessCrystalEqualizer"
    "EQ preset: LoudnessEqualizer"
    "EQ: bypass toggle"
)
pactl list short sinks | grep -q combine_bt_all     && items+=("JBL + Q1 (combined)")
pactl list short sinks | grep -q combine_jbl_laptop && items+=("JBL + Laptop (combined)")
items+=("Disconnect Q1 + JBL" "Status")

choice=$(printf '%s\n' "${items[@]}" | rofi -dmenu -i -p "Audio" -theme-str 'window{width:460px;}') || exit 0

case "$choice" in
    "Q1 receiver"*)
        bluetoothctl connect "$Q1" >/dev/null 2>&1
        wait_sink bluez_output.33_00 && "$HOME/.local/bin/q1-mode" music >/dev/null && set_sink "$Q1_SINK" ;;
    "JBL Charge 5"*)
        bluetoothctl connect "$JBL" >/dev/null 2>&1
        wait_sink bluez_output.F8_5C && set_sink "$JBL_SINK" ;;
    "Laptop"*)        set_sink "$(laptop_sink)" ;;
    "Q1 call"*)       "$HOME/.local/bin/q1-mode" call ;;
    *LoudnessCrystal*) easyeffects -l LoudnessCrystalEqualizer && notify "EQ: LoudnessCrystalEqualizer" ;;
    "EQ preset: LoudnessEqualizer") easyeffects -l LoudnessEqualizer && notify "EQ: LoudnessEqualizer" ;;
    *bypass*)
        easyeffects --bypass-toggle
        sleep 0.5
        if [[ "$(easyeffects -b 3 2>/dev/null)" == 1 ]]; then notify "EQ bypassed"; else notify "EQ active"; fi ;;
    "JBL + Q1"*)      set_sink combine_bt_all ;;
    "JBL + Laptop"*)  set_sink combine_jbl_laptop ;;
    "Disconnect"*)
        bluetoothctl disconnect "$Q1" >/dev/null 2>&1
        bluetoothctl disconnect "$JBL" >/dev/null 2>&1
        notify "Disconnected Q1 + JBL" ;;
    "Status")
        notify "$(pactl get-default-sink)
$("$HOME/.local/bin/q1-mode" status 2>&1)" ;;
esac
